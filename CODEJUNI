<!doctype html>
<html lang="de">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>Enno Haar AR</title>

  <script src="https://aframe.io/releases/1.4.2/aframe.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/mind-ar@1.2.5/dist/mindar-image-aframe.prod.js"></script>

  <style>
    html, body {
      margin: 0;
      padding: 0;
      overflow: hidden;
      background: #000;
      width: 100%;
      height: 100%;
    }

    #hud {
      position: fixed;
      top: 10px;
      left: 10px;
      padding: 8px 10px;
      background: rgba(0,0,0,0.65);
      color: #fff;
      font: 13px -apple-system, system-ui, sans-serif;
      border-radius: 6px;
      z-index: 9999;
      white-space: pre-line;
    }

    .mindar-ui-scanning {
      display: none !important;
    }
  </style>
</head>

<body>
  <div id="hud">STARTING…</div>

  <a-scene
    id="scene"
    embedded
    mindar-image="
      imageTargetSrc: /QR-CODE/targets2.mind;
      autoStart: true;
      uiLoading: false;
      uiScanning: false;
      filterMinCF: 0.0005;
      filterBeta: 0.02;
    "
    renderer="colorManagement:true; antialias:true; alpha:true"
    vr-mode-ui="enabled:false"
    device-orientation-permission-ui="enabled:false"
  >
    <a-assets>
      <a-asset-item id="model" src="/QR-CODE/enno6_test.glb"></a-asset-item>
    </a-assets>

    <a-entity light="type: ambient; intensity: 1.6"></a-entity>
    <a-entity light="type: directional; intensity: 1.2" position="1 2 1"></a-entity>

    <a-entity id="anchor" mindar-image-target="targetIndex: 0">
      <a-entity
        id="modelEnt"
        gltf-model="#model"
        visible="false"
        position="-0.25 0 0.05"
        rotation="0 0 0"
        scale="1.4 1.4 1.4"
      ></a-entity>
    </a-entity>

    <a-camera position="0 0 0" look-controls="enabled:false"></a-camera>
  </a-scene>

  <script>
    const hud = document.getElementById("hud");
    const scene = document.getElementById("scene");
    const anchor = document.getElementById("anchor");
    const modelEnt = document.getElementById("modelEnt");

    scene.addEventListener("loaded", () => {
      hud.textContent = "TARGET: scanning…";
      try {
        scene.renderer.setPixelRatio(Math.min(1.25, window.devicePixelRatio || 1));
        scene.renderer.setClearColor(0x000000, 0);
      } catch {}
    });

    anchor.addEventListener("targetFound", () => {
      modelEnt.setAttribute("visible", "true");
      hud.textContent = "TARGET: FOUND\nMODEL: visible";
    });

    anchor.addEventListener("targetLost", () => {
      modelEnt.setAttribute("visible", "false");
      hud.textContent = "TARGET: LOST";
    });

    modelEnt.addEventListener("model-loaded", () => {
      hud.textContent += "\nGLB: LOADED";
    });

    modelEnt.addEventListener("model-error", () => {
      hud.textContent += "\nGLB: ERROR";
    });
  </script>
</body>
</html>
